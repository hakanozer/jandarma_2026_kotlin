<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_note_item"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not başlığı"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvNoteDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Not detayları burada gösterilecek."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="5"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/border_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:backgroundTint="@color/brand_blue_light"
            android:minWidth="90dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Düzenle"
            android:textAllCaps="false"
            android:textColor="@color/brand_blue" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_orange_light"
            android:minWidth="70dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sil"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange" />

    </LinearLayout>

</LinearLayout>
